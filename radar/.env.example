# Beyblade X 原價開賣雷達 —— 環境變數範本
# 複製成 .env 後填值(.env 已被 .gitignore 排除,勿提交)。
# 一律走環境變數,不要把金鑰寫進程式。

# --- 通知管道(擇一或都填;LINE Notify 已停用) ---
# Telegram bot(向 @BotFather 申請取得 token;chat_id 可用 @userinfobot 查)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord(頻道設定 → 整合 → Webhook 取得 URL)
DISCORD_WEBHOOK_URL=

# --- 分潤 ---
# 蝦皮分潤 ID(過審後填;未填時草稿只放純導流搜尋連結)。
# momo 點點賺已於 2026/01/31 停止,個人分潤只押蝦皮。
SHOPEE_AFFILIATE_ID=

# --- 執行參數(可留空用預設) ---
POLL_INTERVAL_SEC=300      # 輪詢間隔(秒),預設 5 分鐘,低頻尊重站台
IMMINENT_LEAD_MIN=30       # 距開賣幾分鐘進「即將開賣」提醒
RADAR_DB_PATH=radar.db     # SQLite 檔路徑
HTTP_TIMEOUT_SEC=15
# RADAR_USER_AGENT=        # 需要時可覆寫送出的 UA
